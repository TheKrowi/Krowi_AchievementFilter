{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Guard-ToolUse.ps1\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Check-LuaSyntax.ps1\"",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Check-RepoOnStop.ps1\"",
                        "timeout": 60
                    }
                ]
            }
        ]
    },
    "permissions": {
        "additionalDirectories": [
            "../wow-ui-source/"
        ],
        "allow": [
            "Bash(pwsh -NoProfile -NonInteractive -File .claude/tools/Check-Repo.ps1)",
            "Bash(pwsh -NoProfile -NonInteractive -File .claude/tools/Check-Repo.ps1 *)",
            "Bash(pwsh -NoProfile -NonInteractive -File .claude/hooks/Check-LuaSyntax.ps1)",
            "PowerShell(& \".claude\\tools\\Check-Repo.ps1\")",
            "PowerShell(& \".claude\\tools\\Check-Repo.ps1\" *)",
            "PowerShell(& \".claude\\tools\\lua51\\lua.exe\" \".claude\\tools\\headless\\load-data.lua\" \"$PWD\" *)",
            "Bash(./.claude/tools/lua51/lua.exe .claude/tools/headless/load-data.lua \"$PWD\" *)",
            "PowerShell(& \".claude\\tools\\lua51\\lua.exe\" \".claude\\tools\\headless\\run-tests.lua\" \"$PWD\" *)",
            "Bash(./.claude/tools/lua51/lua.exe .claude/tools/headless/run-tests.lua \"$PWD\" *)",
            "PowerShell(& \".claude\\tools\\lua51\\lua.exe\" \".claude\\tools\\lua51\\check-syntax.lua\" *)",
            "PowerShell(& \".claude\\tools\\Read-GameTests.ps1\")",
            "PowerShell(& \".claude\\tools\\Read-GameTests.ps1\" *)",
            "PowerShell(& \".claude\\tools\\Read-GameErrors.ps1\")",
            "PowerShell(& \".claude\\tools\\Read-GameErrors.ps1\" *)",
            "PowerShell(& \".claude\\tools\\Read-GameScreenshot.ps1\")",
            "PowerShell(& \".claude\\tools\\Read-GameScreenshot.ps1\" *)",
            "PowerShell(& \".claude\\tools\\Deploy.ps1\" -WhatIf)",
            "PowerShell(& \".claude\\tools\\Deploy.ps1\" -WhatIf *)",
            "PowerShell(gh pr view *)",
            "PowerShell(gh pr list *)",
            "PowerShell(gh pr diff *)",
            "PowerShell(gh pr checks *)",
            "PowerShell(gh issue view *)",
            "PowerShell(gh issue list *)",
            "PowerShell(gh release view *)",
            "PowerShell(& \".claude\\skills\\release\\Check-ReleaseReady.ps1\")",
            "PowerShell(& \".claude\\skills\\release\\Check-ReleaseReady.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-achievement-data\\_lookup_ids.ps1\")",
            "PowerShell(& \".claude\\skills\\add-achievement-data\\_lookup_ids.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-category-data\\_lookup_ids.ps1\")",
            "PowerShell(& \".claude\\skills\\add-category-data\\_lookup_ids.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_lookup_criteria.ps1\")",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_lookup_criteria.ps1\" *)",
            "PowerShell(& \".claude\\tools\\Get-WowBuilds.ps1\")",
            "PowerShell(& \".claude\\tools\\Find-Symbol.ps1\" *)",
            "PowerShell(& \".claude\\tools\\lua51\\lua.exe\" \".claude\\tools\\headless\\snapshot-data.lua\" \"$PWD\" *)",
            "PowerShell(& \".claude\\tools\\lua51\\lua.exe\" \".claude\\tools\\headless\\snapshot-categories.lua\" \"$PWD\" *)",
            "PowerShell(& \".claude\\skills\\add-achievement-data\\_lookup_holidays.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-achievement-data\\_lookup_mount_id.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-achievement-data\\_lookup_pet_speciesid.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-achievement-data\\_lookup_housingdecor_id.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-category-data\\_lookup_category_names.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-category-data\\_lookup_name.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-category-data\\_evaluate_coverage.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_lookup_ids.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_lookup_quest_maps.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_check_zonedata.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_zone_search.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_linkgroups_search.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_find_zonefile.ps1\" *)",
            "PowerShell(& \".claude\\skills\\add-zone-data\\_check_scripts_reset.ps1\")",
            "PowerShell(& \".claude\\skills\\sync-mapverifier\\_new_maps.ps1\")",
            "PowerShell(& \"raw\\Evaluate-ZoneData.ps1\")",
            "PowerShell(& \"raw\\Evaluate-ZoneData.ps1\" *)"
        ]
    },
    "worktree": {
        "baseRef": "head"
    }
}