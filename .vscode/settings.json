    // Lua language server: the shared config is .luarc.json (Lua 5.1, ignored folders, disabled checks, the
    // globals no annotation covers; kept exact by the luarc lint rule). The ketho.wow-api extension supplies the
    // WoW API annotations and writes its library path into the *user* settings (configurationScope), so nothing
    // machine-specific lands here; FrameXML annotations on for the Blizzard_AchievementUI frames the addon
    // reshapes, and the auto-added known-globals list off so it cannot grow back.
    "wowAPI.luals.frameXML": true,
    "wowAPI.luals.defineKnownGlobals": false,
    "wowAPI.luals.configurationScope": "User",
    "fsdeploy.deployWorkspaceOnSave": true,
    "chat.tools.terminal.autoApprove": {
        "&": true,
        "/Verify-AchievementData\\.ps1/": {
            "approve": true,
            "matchCommandLine": true
        },
        ".\\Test-VerifyScript.ps1": true,
        "/^\\$ids = 151\\.\\.175\n\\$results = @\\(\\)\nforeach \\(\\$id in \\$ids\\) \\{\n    \\$body = \"draw=1&start=0&length=1&search\\[value\\]=\\$id\"\n    try \\{\n        \\$resp = Invoke-RestMethod -Uri \"http://localhost:5000/dbc/data/achievement/\\?build=12\\.0\\.7\\.68275\" -Method POST -Body \\$body -ContentType \"application/x-www-form-urlencoded\"\n        \\$rows = \\$resp\\.data\n        if \\(\\$rows -and \\$rows\\.Count -gt 0\\) \\{\n            # find exact id match\n            \\$match = \\$rows \\| Where-Object \\{ \\$_\\[5\\] -eq \\$id \\}\n            if \\(-not \\$match\\) \\{ \\$match = \\$rows\\[0\\] \\}\n            \\$results \\+= \\[PSCustomObject\\]@\\{ id=\\$id; title=\\$match\\[1\\]; description=\\$match\\[0\\] \\}\n        \\} else \\{\n            \\$results \\+= \\[PSCustomObject\\]@\\{ id=\\$id; title=\"NOT FOUND\"; description=\"\" \\}\n        \\}\n    \\} catch \\{\n        \\$results \\+= \\[PSCustomObject\\]@\\{ id=\\$id; title=\"ERROR: \\$_\"; description=\"\" \\}\n    \\}\n\\}\n\\$results \\| Format-Table -AutoSize\n$/": {
            "approve": true,
            "matchCommandLine": true
        },
        ".\\Evaluate-ZoneData.ps1": true,
        ".\\Evaluate-ZoneDataDecisions.ps1": true,
