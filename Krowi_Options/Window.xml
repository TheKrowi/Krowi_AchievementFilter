<Ui>
    <Script file="WindowMixin.lua"/>

    <!-- The navigation draws as the game's own Options window does (Blizzard_CategoryList.xml), from Blizzard's art only:
         Blizzard's list templates run code that would taint its window (docs/work/2026-10-30-options-settings-look) -->
    <Button name="Krowi_OptionsNavButtonTemplate" mixin="Krowi_OptionsNavButtonMixin" virtual="true">
        <Size y="20"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Texture" hidden="true">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="36" y="1"/>
                        <Anchor point="BOTTOMRIGHT" x="-6" y="1"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" scale=".8" hidden="true">
                <Size x="1" y="1"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Label" relativePoint="LEFT" x="-4" y="-10"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnClick method="OnClick"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <Frame name="Krowi_OptionsNavHeaderTemplate" mixin="Krowi_OptionsNavHeaderMixin" virtual="true">
        <Size y="30"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Background">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Label" inherits="GameFontHighlightMedium" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="20" y="-1"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="Krowi_OptionsNavSpacerTemplate" virtual="true">
        <Size y="18"/>
    </Frame>

    <Frame name="Krowi_OptionsHelpTextTemplate" mixin="Krowi_OptionsHelpTextMixin" virtual="true">
        <Size y="20"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="4" y="-2"/>
                        <Anchor point="BOTTOMRIGHT" x="-4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Button name="Krowi_OptionsHelpPictureTemplate" mixin="Krowi_OptionsHelpPictureMixin" virtual="true">
        <Size y="100"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Picture">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="4" y="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Picture"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Picture"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.12"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick method="OnClick"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!-- The game's own Options frame (SettingsFrameTemplate: each client's border, title strip and background); Blizzard's
         window is laid out in Blizzard_SettingsPanel.xml, which the anchors in WindowMixin.lua's Layout follow -->
    <Frame name="Krowi_OptionsWindowTemplate" mixin="Krowi_OptionsWindowMixin" inherits="SettingsFrameTemplate" frameStrata="HIGH" toplevel="true" enableMouse="true" movable="true" resizable="true" clampedToScreen="true" hidden="true" virtual="true">
        <Size x="1180" y="720"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="PageTitle" inherits="GameFontHighlightHuge" justifyH="LEFT" wordwrap="false"/>
                <FontString parentKey="ChangedText" inherits="GameFontDisableSmall" justifyH="RIGHT"/>
                <FontString parentKey="HelpKicker" inherits="GameFontDisableSmall" justifyH="LEFT"/>
                <FontString parentKey="ReloadText" inherits="GameFontHighlight" justifyH="LEFT"/>
                <FontString parentKey="ShowMeNote" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP"/>
                <FontString parentKey="SearchAllLabel" inherits="GameFontNormalSmall" justifyH="RIGHT" hidden="true"/>
                <Texture parentKey="Divider" atlas="Options_HorizontalDivider"/>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="2">
                <Texture parentKey="NavBackground">
                    <Color r="0" g="0" b="0" a="0.35"/>
                </Texture>
                <Texture parentKey="HelpBackground">
                    <Color r="0" g="0" b="0" a="0.25"/>
                </Texture>
                <Texture parentKey="ReloadBackground" hidden="true">
                    <Color r="1" g="0.82" b="0" a="0.08"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="2">
                <Texture parentKey="InnerFrame" atlas="Options_InnerFrame" hidden="true"/>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Body"/>
            <EditBox parentKey="SearchBox" inherits="SearchBoxTemplate" autoFocus="false" letters="60">
                <Size x="300" y="22"/>
            </EditBox>
            <CheckButton parentKey="SearchAll" inherits="Krowi_OptionsCheckButtonTemplate" hidden="true"/>
            <Frame parentKey="NavScrollBox" inherits="WowScrollBoxList"/>
            <EventFrame parentKey="NavScrollBar" inherits="WowTrimScrollBar"/>
            <Frame parentKey="PageScrollBox" inherits="WowScrollBoxList"/>
            <EventFrame parentKey="PageScrollBar" inherits="WowTrimScrollBar"/>
            <Frame parentKey="HelpScrollBox" inherits="WowScrollBoxList"/>
            <EventFrame parentKey="HelpScrollBar" inherits="WowTrimScrollBar"/>
            <Button parentKey="CollapseButton">
                <Size x="22" y="22"/>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button parentKey="ExpandButton" hidden="true">
                <Size x="22" y="22"/>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button parentKey="ShowMeButton" inherits="UIPanelButtonNoTooltipTemplate" hidden="true">
                <Size x="120" y="22"/>
            </Button>
            <Button parentKey="DefaultsButton" inherits="UIPanelButtonNoTooltipTemplate">
                <Size x="110" y="22"/>
            </Button>
            <Button parentKey="CancelButton" inherits="UIPanelButtonNoTooltipTemplate" hidden="true">
                <Size x="80" y="22"/>
            </Button>
            <Button parentKey="ReloadButton" inherits="UIPanelButtonNoTooltipTemplate" hidden="true">
                <Size x="110" y="22"/>
            </Button>
            <Button parentKey="CloseButton" inherits="UIPanelButtonNoTooltipTemplate">
                <Size x="96" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-26" y="16"/>
                </Anchors>
            </Button>
            <Button parentKey="Lightbox" frameStrata="FULLSCREEN" hidden="true">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Scrim" setAllPoints="true">
                            <Color r="0" g="0" b="0" a="0.75"/>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Picture"/>
                    </Layer>
                </Layers>
            </Button>
            <Button parentKey="ResizeButton">
                <Size x="16" y="16"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
                <HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEvent method="OnEvent"/>
            <OnSizeChanged method="OnSizeChanged"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>
</Ui>