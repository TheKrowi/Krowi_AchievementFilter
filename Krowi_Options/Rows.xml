<Ui>
    <Script file="RowMixins.lua"/>

    <!-- The minimal check box of Blizzard's own settings (Blizzard_SettingControls.xml) -->
    <CheckButton name="Krowi_OptionsCheckButtonTemplate" virtual="true">
        <Size x="30" y="29"/>
        <NormalTexture atlas="checkbox-minimal" useAtlasSize="true"/>
        <PushedTexture atlas="checkbox-minimal" useAtlasSize="true"/>
        <CheckedTexture atlas="checkmark-minimal" useAtlasSize="true"/>
        <DisabledCheckedTexture atlas="checkmark-minimal-disabled" useAtlasSize="true"/>
    </CheckButton>

    <!-- The key button of the game's Keybindings page (Blizzard_Keybindings.xml): UIMenuButtonStretchTemplate's silver art
         (SharedUIPanelTemplates.xml), in pieces without names, and its light while it waits for a key -->
    <Button name="Krowi_OptionsKeyButtonTemplate" mixin="Krowi_OptionsKeyButtonMixin" virtual="true">
        <Size x="160" y="22"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="TopLeft" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Size x="12" y="6"/>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="0" right="0.09375" top="0" bottom="0.1875"/>
                </Texture>
                <Texture parentKey="TopRight" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Size x="12" y="6"/>
                    <Anchors>
                        <Anchor point="TOPRIGHT"/>
                    </Anchors>
                    <TexCoords left="0.53125" right="0.625" top="0" bottom="0.1875"/>
                </Texture>
                <Texture parentKey="BottomLeft" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Size x="12" y="6"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT"/>
                    </Anchors>
                    <TexCoords left="0" right="0.09375" top="0.625" bottom="0.8125"/>
                </Texture>
                <Texture parentKey="BottomRight" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Size x="12" y="6"/>
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <TexCoords left="0.53125" right="0.625" top="0.625" bottom="0.8125"/>
                </Texture>
                <Texture parentKey="TopMiddle" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.TopLeft" relativePoint="TOPRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.TopRight" relativePoint="BOTTOMLEFT"/>
                    </Anchors>
                    <TexCoords left="0.09375" right="0.53125" top="0" bottom="0.1875"/>
                </Texture>
                <Texture parentKey="MiddleLeft" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.TopLeft" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomLeft" relativePoint="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="0" right="0.09375" top="0.1875" bottom="0.625"/>
                </Texture>
                <Texture parentKey="MiddleRight" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.TopRight" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomRight" relativePoint="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="0.53125" right="0.625" top="0.1875" bottom="0.625"/>
                </Texture>
                <Texture parentKey="BottomMiddle" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.BottomLeft" relativePoint="TOPRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="BOTTOMLEFT"/>
                    </Anchors>
                    <TexCoords left="0.09375" right="0.53125" top="0.625" bottom="0.8125"/>
                </Texture>
                <Texture parentKey="MiddleMiddle" file="Interface\Buttons\UI-Silver-Button-Up">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.TopLeft" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="0.09375" right="0.53125" top="0.1875" bottom="0.625"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="SelectedHighlight" file="Interface\Buttons\UI-Silver-Button-Select" alphaMode="ADD" hidden="true">
                    <Size x="160" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER" y="-3"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <ButtonText parentKey="Text" maxLines="1">
            <Size x="150" y="0"/>
            <Anchors>
                <Anchor point="CENTER" y="-1"/>
            </Anchors>
        </ButtonText>
        <NormalFont style="GameFontHighlightSmall"/>
        <HighlightFont style="GameFontHighlightSmall"/>
        <DisabledFont style="GameFontDisableSmall"/>
        <HighlightTexture file="Interface\Buttons\UI-Silver-Button-Highlight" alphaMode="ADD">
            <TexCoords left="0" right="1.0" top="0.03" bottom="0.7175"/>
        </HighlightTexture>
        <Scripts>
            <OnMouseDown method="OnMouseDown"/>
            <OnMouseUp method="Lift"/>
            <OnShow method="Lift"/>
            <OnEnable method="Lift"/>
        </Scripts>
    </Button>

    <Frame name="Krowi_OptionsHeaderRowTemplate" mixin="Krowi_OptionsTextRowMixin" virtual="true">
        <Size y="34"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlightLarge" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="6" y="6"/>
                        <Anchor point="RIGHT" x="-6"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="Krowi_OptionsSubHeadingRowTemplate" mixin="Krowi_OptionsTextRowMixin" virtual="true">
        <Size y="24"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="16"/>
                        <Anchor point="RIGHT" x="-16"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="Krowi_OptionsNoteRowTemplate" mixin="Krowi_OptionsTextRowMixin" virtual="true">
        <Size y="24"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontDisable" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="16" y="-4"/>
                        <Anchor point="BOTTOMRIGHT" x="-16"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="Krowi_OptionsOptionRowTemplate" mixin="Krowi_OptionsOptionRowMixin" enableMouse="true" virtual="true">
        <Size y="30"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Hover" setAllPoints="true" hidden="true">
                    <Color r="1" g="1" b="1" a="0.05"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="true" maxLines="2">
                    <Anchors>
                        <Anchor point="LEFT" x="16"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="ReloadIcon" file="Interface\Buttons\UI-RefreshButton" hidden="true">
                    <Size x="12" y="12"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="6"/>
                    </Anchors>
                </Texture>
                <!-- A changed option: a gold line along the row's left edge, as VS Code marks a modified setting
                     (docs/work/2026-10-31-options-markers) -->
                <Texture parentKey="ChangedBar" hidden="true">
                    <Size x="2"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" y="-4"/>
                        <Anchor point="BOTTOMLEFT" y="4"/>
                    </Anchors>
                    <Color r="1" g="0.82" b="0" a="1"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <!-- Sets a changed option back; shown while the mouse is on its row, in the margin before the name -->
            <Button parentKey="Reset" hidden="true">
                <Size x="12" y="12"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.Label" relativePoint="LEFT" x="-2"/>
                </Anchors>
                <NormalTexture atlas="common-icon-undo"/>
                <HighlightTexture atlas="common-icon-undo" alphaMode="ADD"/>
            </Button>
            <!-- The controls are placed by the row's geometry (RowMixins.lua) at the sizes of the game's Options window
                 (docs/work/2026-11-02-options-widths) -->
            <CheckButton parentKey="Toggle" inherits="Krowi_OptionsCheckButtonTemplate" hidden="true"/>
            <Frame parentKey="Range" inherits="MinimalSliderWithSteppersTemplate" hidden="true">
                <Size x="250" y="20"/>
            </Frame>
            <!-- The game's settings dropdown with an arrow on each side, as Metal2DropdownWithSteppersAndLabelTemplate
                 builds it (docs/work/2026-10-30-options-settings-look) -->
            <Frame parentKey="Select" inherits="DropdownWithSteppersTemplate" hidden="true">
                <Size x="250" y="26"/>
                <Frames>
                    <DropdownButton parentKey="Dropdown" inherits="WowStyle2DropdownTemplate">
                        <Size x="220" y="26"/>
                        <Anchors>
                            <Anchor point="CENTER"/>
                        </Anchors>
                    </DropdownButton>
                </Frames>
            </Frame>
            <Button parentKey="Execute" inherits="UIPanelButtonNoTooltipTemplate" hidden="true">
                <Size x="200" y="22"/>
            </Button>
            <EditBox parentKey="Input" inherits="InputBoxTemplate" autoFocus="false" hidden="true">
                <Size x="240" y="20"/>
            </EditBox>
            <!-- Side by side, as the game's Keybindings page has them (Blizzard_Keybindings.xml) -->
            <Button parentKey="Key1" inherits="Krowi_OptionsKeyButtonTemplate" hidden="true"/>
            <Button parentKey="Key2" inherits="Krowi_OptionsKeyButtonTemplate" hidden="true">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Key1" relativePoint="RIGHT"/>
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Frame>

    <Frame name="Krowi_OptionsSubRowTemplate" mixin="Krowi_OptionsSubRowMixin" virtual="true">
        <Size y="28"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="16"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="All" inherits="UIPanelButtonNoTooltipTemplate">
                <Size x="70" y="20"/>
            </Button>
            <Button parentKey="None" inherits="UIPanelButtonNoTooltipTemplate">
                <Size x="70" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.All" relativePoint="RIGHT" x="6"/>
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="Krowi_OptionsGridHeaderRowTemplate" mixin="Krowi_OptionsGridHeaderRowMixin" virtual="true">
        <Size y="34"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="Krowi_OptionsGridRowTemplate" mixin="Krowi_OptionsGridRowMixin" enableMouse="true" virtual="true">
        <Size y="28"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Hover" setAllPoints="true" hidden="true">
                    <Color r="1" g="1" b="1" a="0.05"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
                    <Size x="180"/>
                    <Anchors>
                        <Anchor point="LEFT" x="16"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Frame>

    <Frame name="Krowi_OptionsTabRowTemplate" mixin="Krowi_OptionsTabRowMixin" enableMouse="true" virtual="true">
        <Size y="28"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Hover" setAllPoints="true" hidden="true">
                    <Color r="1" g="1" b="1" a="0.05"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Position" inherits="GameFontDisable" justifyH="RIGHT">
                    <Size x="20"/>
                    <Anchors>
                        <Anchor point="LEFT" x="10"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="LEFT" x="70"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Source" inherits="GameFontDisableSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="8"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <CheckButton parentKey="ShowCheck" inherits="Krowi_OptionsCheckButtonTemplate">
                <Anchors>
                    <Anchor point="LEFT" x="34"/>
                </Anchors>
            </CheckButton>
            <Button parentKey="Up">
                <Size x="22" y="22"/>
                <NormalTexture file="Interface\Buttons\Arrow-Up-Up"/>
                <PushedTexture file="Interface\Buttons\Arrow-Up-Down"/>
                <DisabledTexture file="Interface\Buttons\Arrow-Up-Disabled"/>
            </Button>
            <Button parentKey="Down">
                <Size x="22" y="22"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Up" relativePoint="RIGHT" x="4"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\Arrow-Down-Up"/>
                <PushedTexture file="Interface\Buttons\Arrow-Down-Down"/>
                <DisabledTexture file="Interface\Buttons\Arrow-Down-Disabled"/>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Frame>

    <Button name="Krowi_OptionsLinkRowTemplate" mixin="Krowi_OptionsLinkRowMixin" virtual="true">
        <Size y="26"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="LEFT" x="16"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Detail" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Text" relativePoint="RIGHT" x="10"/>
                        <Anchor point="RIGHT" x="-16"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <HighlightTexture>
            <Color r="1" g="1" b="1" a="0.08"/>
        </HighlightTexture>
        <Scripts>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>

    <!-- A card (docs/work/2026-11-02-overview-cards): a section's picture, or a game icon, on a dark area at the top, its name
         and NEW, and a line on what it covers, on a dark fill inside a 1 px border that lights under the mouse.
         RowMixins.lua places the name and the line, and cuts the picture to the area. -->
    <Button name="Krowi_OptionsCardTemplate" mixin="Krowi_OptionsCardMixin" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Fill" setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.35"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="PictureArea">
                    <Size y="86"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="1" y="-1"/>
                        <Anchor point="TOPRIGHT" x="-1" y="-1"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="0.5"/>
                </Texture>
            </Layer>
            <Layer level="BORDER" textureSubLevel="1">
                <Texture parentKey="Hover" setAllPoints="true" hidden="true">
                    <Color r="1" g="1" b="1" a="0.05"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Picture">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.PictureArea"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.PictureArea"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="Icon" hidden="true">
                    <Size x="48" y="48"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.PictureArea"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false"/>
                <FontString parentKey="Line" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Name" relativePoint="BOTTOMLEFT" y="-3"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="PictureLine">
                    <Size y="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.PictureArea" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.PictureArea" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.12"/>
                </Texture>
                <Texture parentArray="Edges">
                    <Size y="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="TOPRIGHT"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.12"/>
                </Texture>
                <Texture parentArray="Edges">
                    <Size y="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.12"/>
                </Texture>
                <Texture parentArray="Edges">
                    <Size x="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" y="-1"/>
                        <Anchor point="BOTTOMLEFT" y="1"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.12"/>
                </Texture>
                <Texture parentArray="Edges">
                    <Size x="1"/>
                    <Anchors>
                        <Anchor point="TOPRIGHT" y="-1"/>
                        <Anchor point="BOTTOMRIGHT" y="1"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.12"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <!-- The navigation's NEW (Window.xml), at the right end of the name's line; its offsets are in its own .8 scale -->
            <Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" scale=".8" hidden="true">
                <Size x="1" y="1"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.PictureArea" relativePoint="BOTTOMRIGHT" x="-11.25" y="-17.5"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnClick method="OnClick"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!-- A row of cards, made in OnLoad (RowMixins.lua) as the grid row makes its check boxes -->
    <Frame name="Krowi_OptionsCardRowTemplate" mixin="Krowi_OptionsCardRowMixin" virtual="true">
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>