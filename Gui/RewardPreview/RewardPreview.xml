<Ui>
    <Script file="RewardPreview.lua"/>
    <Script file="RewardPreviewMixin.lua"/>

    <Frame name="KrowiAF_RewardPreview" mixin="KrowiAF_RewardPreviewMixin" parent="UIParent" inherits="TooltipBorderBackdropTemplate" enableMouse="true" movable="true" resizable="true" frameStrata="HIGH" hidden="true">
        <Size x="280" y="360"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="ModelBackground" atlas="catalog-list-preview-bg">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="4" y="-4"/>
                        <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Title" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="8" y="-6"/>
                        <Anchor point="TOPRIGHT" x="-26" y="-6"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="CloseButton" mixin="KrowiAF_RewardPreviewCloseButtonMixin" inherits="UIPanelCloseButtonNoScripts">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick method="OnClick"/>
                </Scripts>
            </Button>
            <Button parentKey="ResizeButton" mixin="KrowiAF_RewardPreviewResizeButtonMixin">
                <Size x="16" y="16"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
                <HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
                <Scripts>
                    <OnMouseDown method="OnMouseDown"/>
                    <OnMouseUp method="OnMouseUp"/>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnMouseDown method="OnMouseDown"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnHide method="OnHide"/>
        </Scripts>
    </Frame>
</Ui>
