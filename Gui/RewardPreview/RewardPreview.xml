<Ui>
    <Script file="RewardPreview.lua"/>
    <Script file="RewardPreviewMixin.lua"/>

    <Frame name="KrowiAF_RewardPreview" mixin="KrowiAF_RewardPreviewMixin" parent="UIParent" inherits="TooltipBorderBackdropTemplate" enableMouse="true" movable="true" resizable="true" frameStrata="HIGH" hidden="true">
        <Size x="280" y="360"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="ModelBackground"> <!-- Atlas/color set in OnLoad; catalog-list-preview-bg doesn't exist on Classic -->
                    <Anchors>
                        <Anchor point="TOPLEFT" x="4" y="-4"/>
                        <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Icon">
                    <Size x="36" y="36"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="8" y="-8"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Title" inherits="GameFontHighlightLarge" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="52" y="-14"/>
                        <Anchor point="TOPRIGHT" x="-26" y="-14"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="CloseButton" mixin="KrowiAF_RewardPreviewCloseButtonMixin" inherits="UIPanelCloseButtonNoScripts">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick method="OnClick"/>
                </Scripts>
            </Button>
            <Button parentKey="ResizeButton" mixin="KrowiAF_RewardPreviewResizeButtonMixin">
                <Size x="16" y="16"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
                <HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
                <Scripts>
                    <OnMouseDown method="OnMouseDown"/>
                    <OnMouseUp method="OnMouseUp"/>
                </Scripts>
            </Button>
            <!-- Browse a collapsed "choice of many" reward group (e.g. Vicious Saddle); hidden unless a multi-entry group is being previewed. Anchored next to Controls' zoomInButton/resetButton row once it's created (see EnsureModelScene) - these are fallback positions. alpha/OnEnter/OnLeave mirror Controls' own dim-until-hovered behavior -->
            <Button parentKey="PrevButton" mixin="KrowiAF_RewardPreviewPrevButtonMixin" hidden="true" alpha="0.5">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="4" y="6"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
                <Scripts>
                    <OnClick method="OnClick"/>
                    <OnEnter method="OnEnter"/>
                    <OnLeave method="OnLeave"/>
                </Scripts>
            </Button>
            <Button parentKey="NextButton" mixin="KrowiAF_RewardPreviewNextButtonMixin" hidden="true" alpha="0.5">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="6"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
                <Scripts>
                    <OnClick method="OnClick"/>
                    <OnEnter method="OnEnter"/>
                    <OnLeave method="OnLeave"/>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnMouseDown method="OnMouseDown"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnHide method="OnHide"/>
        </Scripts>
    </Frame>
</Ui>
